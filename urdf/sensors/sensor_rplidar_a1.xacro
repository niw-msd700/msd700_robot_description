<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
    <!-- From RPLidar A1 spec -->
    <!-- https://www.slamtec.com/en/Lidar/A1 -->
    <xacro:property name="rplidar_weight"  value="0.170" />
    <xacro:property name="rplidar_width"   value="0.076" />
    <xacro:property name="rplidar_length"  value="0.076" />
    <xacro:property name="rplidar_height"  value="0.041" />
    <xacro:macro name="rplidar" params="
        name
        parent
        xyz
        rpy">

        <!-- Joint -->
        <joint name="${name}_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${name}_link"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
        </joint>

        <!-- Link -->
        <link name="${name}_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <!-- Replace with actual RPLidar A1 mesh if available -->
                    <cylinder radius="0.038" length="0.041"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="${rplidar_length} ${rplidar_width} ${rplidar_height}"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="${rplidar_weight}"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <!-- Inertia approximated as a box -->
                <!-- https://en.wikipedia.org/wiki/List_of_moments_of_inertia -->
                <inertia
                    ixx="${(rplidar_weight/12)*(rplidar_width*rplidar_width + rplidar_height*rplidar_height)}"   ixy="0.0" ixz="0.0"
                    iyy="${(rplidar_weight/12)*(rplidar_length*rplidar_length + rplidar_height*rplidar_height)}" iyz="0.0"
                    izz="${(rplidar_weight/12)*(rplidar_length*rplidar_length + rplidar_width*rplidar_width)}"/>
            </inertial>
        </link>

        <gazebo reference="${name}_link">
            <sensor name="${name}_sensor" type="gpu_ray">
                <pose>0 0 0 0 0 0</pose>
                <topic>/scan</topic>
                <gz_frame_id>${name}_link</gz_frame_id>
                <update_rate>10</update_rate>
                <always_on>true</always_on>
                <visualize>true</visualize>
                <ray>
                    <scan>
                        <horizontal>
                            <samples>360</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.14159</min_angle>
                            <max_angle>3.14159</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>0.15</min>
                        <max>12.0</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </ray>
            </sensor>
        </gazebo>
    </xacro:macro>
</robot>
