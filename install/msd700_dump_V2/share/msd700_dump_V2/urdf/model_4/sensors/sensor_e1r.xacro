<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
    <!-- Head dimensions measured from the STL -->
    <xacro:property name="e1r_weight"  value="0.33" />   
    <xacro:property name="e1r_length"  value="0.089" />
    <xacro:property name="e1r_width"   value="0.182" />
    <xacro:property name="e1r_height"  value="0.125" />

    <xacro:macro name="e1r" params="
        name
        parent
        xyz
        rpy">

        <joint name="${name}_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${name}"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
        </joint>

        <link name="${name}">
            <visual>
                <origin xyz="0.08 0.092 -0.55" rpy="${pi/2} 0 -${pi/2}"/>
                <geometry>
                    <mesh filename="package://msd700_dump_V2/meshes/MCLA022A_E1R_LIDAR.STL"
                        scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="NavyBlue">
                    <color rgba="0.0 0.0 0.5 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="${e1r_length} ${e1r_width} ${e1r_height}"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="${e1r_weight}"/>
                <!-- the inertial matrix approximated as a box -->
                <inertia
                    ixx="${(e1r_weight/12)*(0.095*0.095 + 0.043*0.043)}"   ixy="0.0" ixz="0.0"
                    iyy="${(e1r_weight/12)*(0.0695*0.0695 + 0.043*0.043)}" iyz="0.0"
                    izz="${(e1r_weight/12)*(0.0695*0.0695 + 0.095*0.095)}"/>
            </inertial>
        </link>
    </xacro:macro>
</robot>
