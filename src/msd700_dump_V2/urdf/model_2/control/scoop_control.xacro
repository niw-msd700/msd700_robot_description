<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!--
    Scoop Control Xacro
    Adds joint control for the scoop in Gazebo simulation.

    Joint: scoop_joint
    Limits: 0 to -30 degrees (0 to -0.524 rad)
    Control topic: /scoop_controller/command
    -->

    <!-- Transmission for ros_control -->
    <transmission name="scoop_trans">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="scoop_joint">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        </joint>
        <actuator name="scoop_motor">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>

    <!-- Gazebo ros_control plugin -->
    <gazebo>
        <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
            <robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType>
        </plugin>
    </gazebo>

    <!-- Gazebo material and physics properties -->
    <gazebo reference="scoop_arm_link">
        <material>Gazebo/Grey</material>
        <mu1>0.8</mu1>
        <mu2>0.8</mu2>
        <selfCollide>false</selfCollide>
    </gazebo>

    <gazebo reference="scoop_link">
        <material>Gazebo/Grey</material>
        <mu1>0.8</mu1>
        <mu2>0.8</mu2>
        <selfCollide>false</selfCollide>
    </gazebo>

    <!-- Gazebo joint properties for stability -->
    <gazebo reference="scoop_joint">
        <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>

</robot>